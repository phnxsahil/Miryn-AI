# syntax=docker/dockerfile:1
# Place at miryn/backend/Dockerfile.render. Build context: miryn/backend.
# Verified source baseline: phnxsahil/Miryn-AI feaaf33.
FROM python:3.11-slim AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ libpq-dev \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

FROM python:3.11-slim
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PORT=10000 APP_ENV=production OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 miryn
COPY --from=builder /opt/venv /opt/venv
COPY . .
# Small, explicit deployment patches. Fail the build on unexpected source drift.
# Neon PgBouncer rejects the repo's startup statement_timeout/lock_timeout.
# Keep those options for direct URLs, remove them only for the pooled hostname.
RUN python - <<'PY'
from pathlib import Path
p = Path('app/core/database.py')
s = p.read_text()
needle = '''"options": "-c statement_timeout=30000 -c lock_timeout=10000",'''
assert s.count(needle) == 1, 'Database source changed; review pooled-URL patch'
s = s.replace(needle, '''**({} if "-pooler." in settings.DATABASE_URL else {
                        "options": "-c statement_timeout=30000 -c lock_timeout=10000"
                    }),''')
assert s.count('"pool_size": 5') == s.count('"max_overflow": 10') == 1
s = s.replace('"pool_size": 5', '"pool_size": 2').replace('"max_overflow": 10', '"max_overflow": 2')
p.write_text(s)
p = Path('app/workers/celery_app.py')
s = p.read_text()
needle = 'celery_app.conf.timezone = "UTC"'
assert s.count(needle) == 1, 'Celery source changed; review free-tier patch'
s = s.replace(needle, needle + '''
# Free Key Value is 25 MB and shared with app caches/events.
celery_app.conf.update(
    task_ignore_result=True,
    task_store_errors_even_if_ignored=False,
    result_expires=3600,
    broker_pool_limit=2,
    redis_max_connections=8,
    worker_prefetch_multiplier=1,
    worker_enable_remote_control=False,
    broker_connection_retry_on_startup=True,
)
''')
p.write_text(s)
PY
USER miryn
EXPOSE 10000
CMD ["python", "start-render.py"]
