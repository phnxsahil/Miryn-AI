# Database (Supabase)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database (optional local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miryn

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
# Claude model id (check Anthropic model docs; ids are pinned snapshots)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Lifetime USD ceiling across all workers; 0 = Claude calls refused
ANTHROPIC_TOTAL_BUDGET_USD=0
# Spend already incurred outside the ledger (earlier tests); deducted from the cap
ANTHROPIC_PRIOR_SPEND_USD=0
# Optional price override (both); leave unset to use the built-in table for known models
# ANTHROPIC_INPUT_USD_PER_MTOK=
# ANTHROPIC_OUTPUT_USD_PER_MTOK=
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
LLM_PROVIDER=gemini

# Importance scoring
# IMPORTANCE_CORE_THRESHOLD=0.75
# IMPORTANCE_USE_LLM=true
# IMPORTANCE_MAX_FACTS_PER_MESSAGE=3

# App
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Security
SECRET_KEY=your_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
# TRUST_PROXY_HEADERS=false  # Set true behind Render/Vercel/nginx.

# Email
RESEND_API_KEY=your_resend_api_key_here

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
